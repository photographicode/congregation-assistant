{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{mjs,cjs,ts,py}",
        "tests/**/*.test.{ts,mjs}",
        "eslint.config.mjs",
        "vitest.config.ts",
        "tests/v3/store-browser-fixture.ts",
        "tests/v3/ui-kit-browser-fixture.tsx",
        "tests/v3/overlay-fixture.tsx",
        "tests/v3/ui-fixture.tsx"
      ],
      "project": [
        "scripts/**/*.{mjs,cjs,ts}",
        "tests/**/*.{ts,tsx}"
      ]
    },
    "apps/web": {
      "entry": [
        "src/main.tsx",
        "src/features/crypto.worker.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,mjs}"
      ]
    },
    "packages/core": {
      "entry": [
        "*.{ts,mjs}"
      ],
      "project": [
        "*.{ts,mjs}"
      ]
    },
    "packages/ui": {
      "entry": [
        "*.{ts,tsx}"
      ],
      "project": [
        "*.{ts,tsx}"
      ]
    },
    "packages/pdf": {
      "entry": [
        "*.{ts,mjs}"
      ],
      "project": [
        "*.{ts,mjs}"
      ]
    }
  },
  "includeEntryExports": true,
  "ignoreDependencies": [
    "@fontsource-variable/*",
    "@fontsource/*"
  ],
  "ignoreBinaries": [
    "pdffonts",
    "pdftotext"
  ],
  "ignoreIssues": {
    "eslint.config.mjs": [
      "exports"
    ],
    "vitest.config.ts": [
      "exports"
    ]
  }
}
