{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "congregation-assistant-site",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {"directory": "../dist-site", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "404-page"},
  "vars": {"APP_HOST": "false"},
  "routes": [{"pattern": "congregationassistant.com", "custom_domain": true}, {"pattern": "www.congregationassistant.com", "custom_domain": true}]
}
