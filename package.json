{
  "name": "congregation-assistant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node scripts/check-public-safety.cjs && vitest run",
    "test:browser": "node scripts/check-cutover-browser.cjs",
    "dev:v2": "vite --config apps/web/vite.config.ts",
    "build:v2": "node scripts/build-v2.mjs",
    "check:v2": "npm run check",
    "test:v2:browser": "node scripts/check-cutover-browser.cjs",
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "node scripts/build-v2.mjs",
    "preview": "node scripts/serve-cutover.cjs",
    "check": "npm run lint && tsc -p apps/web/tsconfig.json --noEmit && vitest run && node --test scripts/v2-tests/*.test.mjs",
    "lint": "eslint apps/web/src packages/ui packages/core packages/pdf --max-warnings 0",
    "check:bundle": "node scripts/check-no-legacy.mjs --bundle",
    "check:release": "node scripts/check-cutover-release.mjs",
    "test:legacy:browser": "node scripts/check-browser.cjs",
    "check:standalone": "node scripts/check-standalone.mjs",
    "test:pdf": "node scripts/generate-v2-pdf-fixtures.mjs && node scripts/check-pdf-contract.mjs && node scripts/check-r1-pdf-semantic.mjs && python3 scripts/check-r1-pdf-parity.py && node scripts/check-unicode-native-pdf.mjs",
    "test:pdf:browser": "node scripts/check-pdf-browser.cjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:dns": "node scripts/dns-preflight.mjs",
    "check:contrast": "node scripts/contrast-check.mjs",
    "test:v3:ui": "node scripts/check-v3-ui.mjs",
    "test:v3:themes": "node scripts/check-v3-themes-browser.cjs",
    "test:v3:store": "node scripts/check-v3-store-browser.mjs",
    "test:v3:offline": "node scripts/check-v3-offline-app.cjs",
    "test:v3:shell": "node scripts/check-v3-shell.cjs",
    "check:r1": "node scripts/check-r1-release.mjs",
    "check:vercel-guidelines": "node scripts/vercel-guidelines-audit.mjs",
    "check:final": "node scripts/check-final-release.mjs",
    "check:style": "node scripts/check-style-ratchet.mjs",
    "check:css": "node scripts/css-audit.mjs",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs apps/web/src packages/core packages/ui packages/pdf",
    "check:cycles": "madge --circular --extensions ts,tsx,mjs --ts-config apps/web/tsconfig.json apps/web/src packages/core packages/ui packages/pdf",
    "check:unused": "knip",
    "check:duplication": "jscpd",
    "check:size": "size-limit",
    "check:lint-ratchet": "node scripts/check-eslint-ratchet.mjs",
    "test:coverage": "node scripts/check-coverage-ratchet.mjs && vitest run --coverage",
    "changeset": "changeset",
    "quality": "npm run check:strict-types && npm run lint && npm run check:lint-ratchet && npm run check:style && npm run check:css && npm run check:architecture && npm run check:cycles && npm run check:unused && npm run check:duplication && npm run test:coverage",
    "check:strict-types": "node scripts/check-types-ratchet.mjs",
    "check:workflow-security": "node scripts/check-workflow-security.mjs",
    "check:strict-types:all": "tsc -p tsconfig.strict.json --noEmit",
    "check:style:all": "stylelint \"packages/ui/**/*.css\" \"apps/web/src/**/*.css\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@changesets/cli": "3.0.3",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/arimo": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/noto-nastaliq-urdu": "5.3.0",
    "@fontsource/noto-sans-oriya": "5.3.0",
    "@fontsource/noto-serif-bengali": "5.3.0",
    "@fontsource/noto-serif-devanagari": "5.3.0",
    "@fontsource/noto-serif-gujarati": "5.3.0",
    "@fontsource/noto-serif-gurmukhi": "5.3.0",
    "@fontsource/noto-serif-kannada": "5.3.0",
    "@fontsource/noto-serif-malayalam": "5.3.0",
    "@fontsource/noto-serif-tamil": "5.3.0",
    "@fontsource/noto-serif-telugu": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@size-limit/file": "14.2.0",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-v8": "4.1.12",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "fake-indexeddb": "6.2.6",
    "fast-check": "^4.3.0",
    "jscpd": "5.4.2",
    "knip": "6.42.1",
    "linkedom": "^0.18.12",
    "madge": "8.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "postcss": "8.5.29",
    "sharp": "0.35.5",
    "size-limit": "14.2.0",
    "stylelint": "17.16.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "ts-morph": "28.0.0",
    "typescript-eslint": "8.46.2",
    "vitest": "4.1.12",
    "wrangler": "4.151.3",
    "esbuild": "0.25.12",
    "date-fns": "4.1.0",
    "fontkit": "2.0.4",
    "@tanstack/react-query": "5.90.5",
    "@typescript-eslint/parser": "8.46.2",
    "react": "19.3.1",
    "react-dom": "18.3.1",
    "idb": "8.0.4",
    "zod": "4.6.7",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  },
  "workspaces": [
    "apps/web",
    "packages/ui",
    "packages/core",
    "packages/pdf"
  ],
  "overrides": {
    "postcss-selector-parser": "7.1.6",
    "undici@7.29.1": "7.30.1"
  }
}
