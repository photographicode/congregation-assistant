{
  "name": "congregation-assistant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node scripts/check-public-safety.cjs && vitest run",
    "test:browser": "node scripts/check-cutover-browser.cjs",
    "dev:v2": "vite --config apps/web/vite.config.ts",
    "build:v2": "node scripts/build-v2.mjs",
    "check:v2": "npm run check",
    "test:v2:browser": "node scripts/check-cutover-browser.cjs",
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "node scripts/build-v2.mjs",
    "preview": "node scripts/serve-cutover.cjs",
    "check": "npm run lint && tsc -p apps/web/tsconfig.json --noEmit && vitest run && node --test scripts/v2-tests/*.test.mjs",
    "lint": "eslint apps/web/src packages/ui packages/core packages/pdf",
    "check:bundle": "node scripts/check-no-legacy.mjs --bundle",
    "check:release": "node scripts/check-cutover-release.mjs",
    "test:legacy:browser": "node scripts/check-browser.cjs",
    "check:standalone": "node scripts/check-standalone.mjs",
    "test:pdf": "node scripts/generate-v2-pdf-fixtures.mjs && node scripts/check-pdf-contract.mjs && node scripts/check-r1-pdf-semantic.mjs && python3 scripts/check-r1-pdf-parity.py && node scripts/check-unicode-native-pdf.mjs",
    "test:pdf:browser": "node scripts/check-pdf-browser.cjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:dns": "node scripts/dns-preflight.mjs",
    "check:contrast": "node scripts/contrast-check.mjs",
    "test:v3:ui": "node scripts/check-v3-ui.mjs",
    "test:v3:themes": "node scripts/check-v3-themes-browser.cjs",
    "test:v3:store": "node scripts/check-v3-store-browser.mjs",
    "test:v3:offline": "node scripts/check-v3-offline-app.cjs",
    "test:v3:shell": "node scripts/check-v3-shell.cjs",
    "check:r1": "node scripts/check-r1-release.mjs"
    ,"check:final": "node scripts/check-final-release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "9.39.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/arimo": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/noto-nastaliq-urdu": "5.3.0",
    "@fontsource/noto-sans-oriya": "5.3.0",
    "@fontsource/noto-serif-bengali": "5.3.0",
    "@fontsource/noto-serif-devanagari": "5.3.0",
    "@fontsource/noto-serif-gujarati": "5.3.0",
    "@fontsource/noto-serif-gurmukhi": "5.3.0",
    "@fontsource/noto-serif-kannada": "5.3.0",
    "@fontsource/noto-serif-malayalam": "5.3.0",
    "@fontsource/noto-serif-tamil": "5.3.0",
    "@fontsource/noto-serif-telugu": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@types/qrcode": "1.5.5",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "fake-indexeddb": "6.2.6",
    "fast-check": "^4.3.0",
    "linkedom": "^0.18.12",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "3.4.17",
    "typescript-eslint": "8.46.2",
    "vitest": "3.2.4",
    "wrangler": "4.76.0"
  },
  "workspaces": [
    "apps/web",
    "packages/ui",
    "packages/core",
    "packages/pdf"
  ],
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
